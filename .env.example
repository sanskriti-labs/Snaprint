# Easy!Appointments API key — generate in the EA admin panel under
# Settings > API > Generate. Required for /api/book/* routes.
EA_API_KEY=

# Optional override; defaults to https://book.sanskritilabs.in if unset.
# EA_BASE_URL=

# Google Search Console verification token (content value of the
# <meta name="google-site-verification"> tag GSC gives you). Get it from
# search.google.com/search-console -> Add property -> snaprints.com -> HTML tag method.
# GOOGLE_SITE_VERIFICATION=

# IndexNow API key — must match the key file served at
# public/<key>.txt (https://snaprints.com/<key>.txt). Used by
# scripts/seo/indexnow-submit.mjs to notify Bing/Yandex of URL changes.
# See docs/seo/indexnow-setup.md.
# INDEXNOW_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
# Required by /api/cron/gsc-export and /api/cron/indexnow.
# CRON_SECRET=

# Cloudflare Worker base URL that /api/desktop-registrations forwards self-serve shop
# signups to (POST /api/v1/shops/register). Defaults to production if unset.
# SNAPRINT_WORKER_URL=https://kiosk.snaprints.com
