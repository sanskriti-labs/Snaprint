# Easy!Appointments API key — generate in the EA admin panel under
# Settings > API > Generate. Required for /api/book/* routes.
EA_API_KEY=

# Optional override; defaults to https://book.sanskritilabs.in if unset.
# EA_BASE_URL=

# Google Search Console verification token (content value of the
# <meta name="google-site-verification"> tag GSC gives you). Get it from
# search.google.com/search-console -> Add property -> snaprints.com -> HTML tag method.
# GOOGLE_SITE_VERIFICATION=
